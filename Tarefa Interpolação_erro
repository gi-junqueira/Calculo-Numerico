      "cell_type": "code",
      "source": [
        "sigma = 0.05\n",
        "rng = np.random.default_rng(0)\n",
        "linhas = []\n",
        "for N in [7, 13, 25, 41]:\n",
        "    xe = np.linspace(0, L, N); xc = nos_chebyshev_lobatto(0, L, N)\n",
        "    rmse = {}\n",
        "    for _ in range(100):\n",
        "        ye = temperatura_real(xe) + rng.normal(0, sigma, N)\n",
        "        yc = temperatura_real(xc) + rng.normal(0, sigma, N)\n",
        "        metodos = {\"Lagrange equiespaçado\": BarycentricInterpolator(xe, ye),\n",
        "                   \"Lagrange Chebyshev\": BarycentricInterpolator(xc, yc),\n",
        "                   \"Spline cúbica natural\": CubicSpline(xe, ye, bc_type=\"natural\"),\n",
        "                   \"Spline de suavização\": make_smoothing_spline(xe, ye)}\n",
        "        for nome, m in metodos.items():\n",
        "            rmse.setdefault(nome, []).append(np.sqrt(np.mean((m(x_fino) - T_fino)**2)))\n",
        "    for nome, v in rmse.items():\n",
        "        linhas.append({\"N\": N, \"Método\": nome, \"RMSE médio (°C)\": np.mean(v)})\n",
        "display(pd.DataFrame(linhas).pivot(index=\"Método\", columns=\"N\", values=\"RMSE médio (°C)\"))\n",
