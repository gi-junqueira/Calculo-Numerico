        "def spline_quadratica_coef(x, y):\n",
        "    \"\"\"Spline quadrática C1 com condição c_0=0; retorna a,b,c locais.\"\"\"\n",
        "    x = np.asarray(x, float); y = np.asarray(y, float)\n",
        "    n = len(x)-1\n",
        "    if n < 1 or len(y) != len(x) or np.any(np.diff(x) <= 0):\n",
        "        raise ValueError(\"x deve ser crescente e ter o mesmo tamanho de y.\")\n",
        "    A = np.zeros((3*n, 3*n)); rhs = np.zeros(3*n); row = 0\n",
        "    for i in range(n):                       # S_i(x_i)=y_i\n",
        "        A[row, i] = 1; rhs[row] = y[i]; row += 1\n",
        "    for i in range(n):                       # S_i(x_{i+1})=y_{i+1}\n",
        "        h = x[i+1]-x[i]\n",
        "        A[row, i] = 1; A[row, n+i] = h; A[row, 2*n+i] = h*h\n",
        "        rhs[row] = y[i+1]; row += 1\n",
        "    for i in range(n-1):                     # continuidade de S'\n",
        "        h = x[i+1]-x[i]\n",
        "        A[row, n+i] = 1; A[row, 2*n+i] = 2*h; A[row, n+i+1] = -1\n",
        "        row += 1\n",
        "    A[row, 2*n] = 1                          # c_0 = 0\n",
        "    coef = np.linalg.solve(A, rhs)\n",
        "    return coef[:n], coef[n:2*n], coef[2*n:]\n",
        "\n",
        "def spline_quadratica_avalia(x, coef, xq):\n",
        "    a, b, c = coef\n",
        "    xq = np.asarray(xq, dtype=float)\n",
        "    idx = np.clip(np.searchsorted(x, xq, side=\"right\")-1, 0, len(a)-1)\n",
        "    t = xq-x[idx]\n",
        "    return a[idx] + b[idx]*t + c[idx]*t**2\n",
        "\n",
        "def criar_metodos(x, y):\n",
        "    \"\"\"Retorna dicionário com os interpoladores (callables) dos quatro métodos.\"\"\"\n",
        "    lagrange = BarycentricInterpolator(x, y)\n",
        "    linear = interp1d(x, y, kind=\"linear\", bounds_error=True)\n",
        "    quad_coef = spline_quadratica_coef(x, y)\n",
        "    quad = lambda z: spline_quadratica_avalia(x, quad_coef, z)\n",
        "    cubica = CubicSpline(x, y, bc_type=\"natural\")\n",
        "    return {\"Lagrange global\": lagrange, \"Spline linear\": linear,\n",
        "            \"Spline quadrática\": quad, \"Spline cúbica natural\": cubica}\n",
        "\n",
        "def calcular_metricas(metodos, x_teste, y_verdadeiro):\n",
        "    linhas = []\n",
        "    for nome, metodo in metodos.items():\n",
        "        erro = np.asarray(metodo(x_teste))-np.asarray(y_verdadeiro)\n",
        "        linhas.append({\"Método\": nome,\n",
        "                       \"Erro máximo (°C)\": np.max(np.abs(erro)),\n",
        "                       \"MAE (°C)\": np.mean(np.abs(erro)),\n",
        "                       \"RMSE (°C)\": np.sqrt(np.mean(erro**2))})\n",
        "    return pd.DataFrame(linhas).sort_values(\"RMSE (°C)\").reset_index(drop=True)\n",
        "\n",
        "def nos_chebyshev_lobatto(a, b, N):\n",
        "    k = np.arange(N)\n",
        "    z = np.cos(k*np.pi/(N-1))\n",
        "    return np.sort((a+b)/2 + (b-a)*z/2)\n",
        "print(\"Funções de interpolação e métricas definidas.\")"
