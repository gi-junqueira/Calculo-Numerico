      "cell_type": "markdown",
      "source": [
        "## Etapa 3 — Variação de $N$ de 4 a 40"
      ],
      "metadata": {
        "id": "GHEyoLNXnR-f"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "linhas = []\n",
        "for N in range(4, 41):\n",
        "    xe = np.linspace(x_min, x_max, N)\n",
        "    xc = nos_chebyshev_lobatto(x_min, x_max, N)\n",
        "    casos = {\"Lagrange equiespaçado\": (xe, BarycentricInterpolator),\n",
        "             \"Lagrange Chebyshev\": (xc, BarycentricInterpolator),\n",
        "             \"Spline cúbica natural\": (xe, lambda x, y: CubicSpline(x, y, bc_type=\"natural\"))}\n",
        "    for nome, (xn, construtor) in casos.items():\n",
        "        yn = temperatura_real(xn)\n",
        "        t0 = time.perf_counter(); interp = construtor(xn, yn); t1 = time.perf_counter()\n",
        "        p = interp(x_fino); t2 = time.perf_counter()\n",
        "        erro = p - T_fino\n",
        "        linhas.append({\"N\": N, \"Método\": nome, \"Erro máximo (°C)\": np.max(np.abs(erro)),\n",
        "                       \"RMSE (°C)\": np.sqrt(np.mean(erro**2)),\n",
        "                       \"t construção (ms)\": 1e3*(t1-t0), \"t avaliação (ms)\": 1e3*(t2-t1)})\n",
        "estudo = pd.DataFrame(linhas)\n",
