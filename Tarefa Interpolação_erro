      "source": [
        "def nos_chebyshev_lobatto(a, b, N):\n",
        "    k = np.arange(N)\n",
        "    z = np.cos(k*np.pi/(N-1))\n",
        "    return np.sort((a+b)/2 + (b-a)*z/2)\n",
        "\n",
        "linhas = []\n",
        "for N in [5, 9, 13, 17]:\n",
        "    for dist, xn in [(\"Equiespaçado\", np.linspace(x_min, x_max, N)),\n",
        "                     (\"Chebyshev\", nos_chebyshev_lobatto(x_min, x_max, N))]:\n",
        "        erro = BarycentricInterpolator(xn, temperatura_real(xn))(x_fino) - T_fino\n",
        "        linhas.append({\"N\": N, \"Nós\": dist, \"Erro máximo (°C)\": np.max(np.abs(erro)),\n",
        "                       \"RMSE (°C)\": np.sqrt(np.mean(erro**2))})\n",
        "tabela_nos = pd.DataFrame(linhas)\n",
        "display(tabela_nos)"
